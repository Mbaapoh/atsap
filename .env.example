# Copy to .env for local development: cp .env.example .env
# These values must match deploy/asterisk/conf/{ari,manager}.conf.

LOG_LEVEL=info
HTTP_ADDR=:8080

ARI_URL=http://asterisk:8088/ari
ARI_USERNAME=voipapp
ARI_PASSWORD=devpassword123
ARI_APP_NAME=voip-app

AMI_ADDR=asterisk:5038
AMI_USERNAME=voipapp
AMI_PASSWORD=devpassword123

# CDR/CEL storage (Asterisk writes directly to Postgres; the Go app doesn't
# use these). Must match deploy/asterisk/conf/{cdr,cel}_pgsql.conf and the
# `postgres` service in deploy/docker-compose.yml. Used for local `psql`
# access only.
POSTGRES_DB=asterisk
POSTGRES_USER=asterisk
POSTGRES_PASSWORD=devpassword123
