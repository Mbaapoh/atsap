# Copy to .env for local development: cp .env.example .env
# These values must match core/conf/{ari,manager}.conf.

LOG_LEVEL=info
HTTP_ADDR=:8080

ARI_URL=http://asterisk:8088/ari
ARI_USERNAME=voipapp
ARI_PASSWORD=devpassword123
ARI_APP_NAME=voip-app

AMI_ADDR=asterisk:5038
AMI_USERNAME=voipapp
AMI_PASSWORD=devpassword123

# NATS JetStream (used from the telephony-core walking skeleton onwards).
NATS_URL=nats://nats:4222

# AtsaPBX domain database — separate from the `asterisk` CDR/CEL database
# Asterisk writes to. Provisioned alongside it (deploy/postgres/init/
# 02-atsapbx.sql) when the walking skeleton lands; the Go app connects here,
# never to the cdr/cel database. See openspec/changes/.../design.md.
DATABASE_URL=postgres://atsapbx_app:devpassword123@postgres:5432/atsapbx?sslmode=disable

# Gate for the dev-tenant seed migration (0002_dev_tenant_seed). Set true
# only for a local dev database; never true in production.
ATSAPBX_SEED_DEV_TENANT=false

# CDR/CEL storage (Asterisk writes directly to Postgres; the Go app doesn't
# use these). Must match core/conf/{cdr,cel}_pgsql.conf and the `postgres`
# service in deploy/docker-compose.yml. Used for local `psql` access only.
POSTGRES_DB=asterisk
POSTGRES_USER=asterisk
POSTGRES_PASSWORD=devpassword123
