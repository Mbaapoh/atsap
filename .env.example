# AtsaPBX environment contract (12-factor, factor III: config lives in the
# environment, never in images). Copy to .env for local development:
#   cp .env.example .env
#
# Precedence for `docker compose` runs: a service's `environment:` entries
# in the compose file WIN over this file (`env_file`). Service hostnames
# below (asterisk, postgres, nats) must match the service names in
# deploy/docker-compose*.yml — compose owns the topology; this file echoes
# it so non-compose runs (`mise run run`, psql, Go tests) agree.
# Every credential below is DEV-ONLY. Never reuse these in production.

# --- app server ---
LOG_LEVEL=info
HTTP_ADDR=:8080

# --- Asterisk control (ARI/AMI). Must match core/conf/{ari,manager}.conf.
ARI_URL=http://asterisk:8088/ari
ARI_USERNAME=voipapp
ARI_PASSWORD=devpassword123
ARI_APP_NAME=voip-app

AMI_ADDR=asterisk:5038
AMI_USERNAME=voipapp
AMI_PASSWORD=devpassword123

# --- backing services (dev hostnames = compose service names) ---
# NATS JetStream (used from the telephony-core walking skeleton onwards).
NATS_URL=nats://nats:4222

# AtsaPBX domain database — separate from the `asterisk` CDR/CEL database
# Asterisk writes to. Provisioned alongside it (deploy/postgres/init/
# 02-atsapbx.sql) when the walking skeleton lands; the Go app connects here,
# never to the cdr/cel database. See openspec/changes/.../design.md.
# Consumed by config.Load from task 9.2 onwards; reserved here meanwhile.
DATABASE_URL=postgres://atsapbx_app:devpassword123@postgres:5432/atsapbx?sslmode=disable

# --- gates ---
# Gate for the dev-tenant seed migration (0002_dev_tenant_seed). Set true
# only for a local dev database; never true in production.
ATSAPBX_SEED_DEV_TENANT=false

# --- Asterisk CDR/CEL writer credentials (Asterisk's own DSN) ---
# The Go app never uses these. Must match core/conf/{cdr,cel}_pgsql.conf
# and the `postgres` service in deploy/docker-compose.yml. Used for local
# `psql` access only.
POSTGRES_DB=asterisk
POSTGRES_USER=asterisk
POSTGRES_PASSWORD=devpassword123
