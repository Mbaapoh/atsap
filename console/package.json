{
  "name": "atsapbx-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AtsaPBX Phase A administration console: a public-API consumer of the AtsaPBX ConnectRPC services.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen": "buf generate ../api --template buf.gen.yaml",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:ratchet": "node scripts/ratchet-coverage.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test --project e2e",
    "integration": "ATSAPBX_RIG_REQUIRED=1 playwright test --project integration",
    "uat": "ATSAPBX_RIG_REQUIRED=1 playwright test --project uat",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@tanstack/react-query": "5.104.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
